#!/usr/bin/env bash
# Description: Validates and securely encrypts the Bitwarden info file with AES256

set -euo pipefail

BITWARDEN_DIR="${HOME}/.bitwarden"
INFO_FILE="${BITWARDEN_DIR}/bitwarden-info"
GPG_FILE="${BITWARDEN_DIR}/bitwarden-info.gpg"

# 1. Verify TTY for interactive prompts
if [[ ! -t 0 ]]; then
    echo "[!] Error: bitwarden-lock must be run interactively in a terminal." >&2
    exit 1
fi

# 2. Check if info file exists
if [[ ! -f "$INFO_FILE" ]]; then
    if [[ -f "$GPG_FILE" ]]; then
        echo "[i] The info file '${INFO_FILE}' does not exist, but '${GPG_FILE}' already exists." >&2
        echo "[i] Use 'bitwarden-unlock' to decrypt and view your credentials." >&2
    else
        echo "[!] Error: The info file '${INFO_FILE}' does not exist." >&2
        echo "[!] Please create and fill '${INFO_FILE}' before encrypting." >&2
    fi
    exit 1
fi

# 3. Check if info file is empty
if [[ ! -s "$INFO_FILE" ]]; then
    echo "[!] Error: '${INFO_FILE}' is empty. Please fill it with your credentials before encrypting." >&2
    exit 1
fi

# 4. Check for '<no_value:' placeholders
if grep -q '<no_value:' "$INFO_FILE"; then
    echo "[!] Error: '${INFO_FILE}' still contains placeholder '<no_value:...' fields." >&2
    echo "[!] Please edit '${INFO_FILE}' and fill it with your real Bitwarden information." >&2
    exit 1
fi

# 5. Overwrite confirmation if encrypted file already exists (No default)
if [[ -f "$GPG_FILE" ]]; then
    while true; do
        read -rp "Encrypted file '${GPG_FILE}' already exists. Overwrite? (yes/y or no/n): " answer
        case "${answer,,}" in
            y|yes)
                break
                ;;
            n|no)
                echo "Aborted. '${GPG_FILE}' was not overwritten."
                exit 0
                ;;
            *)
                echo "Please answer explicitly with 'yes'/'y' or 'no'/'n'."
                ;;
        esac
    done
fi

# 6. Encrypt with GPG AES256
echo "[+] Encrypting '${INFO_FILE}' with AES256..."
if ! sudo gpg --yes --symmetric --cipher-algo AES256 \
    --s2k-cipher-algo AES256 --s2k-digest-algo SHA512 --s2k-count 65011712 \
    -o "$GPG_FILE" "$INFO_FILE"; then
    echo "[!] Error: GPG encryption failed." >&2
    exit 1
fi

if [[ ! -f "$GPG_FILE" || ! -s "$GPG_FILE" ]]; then
    echo "[!] Error: Encrypted file '${GPG_FILE}' was not created or is empty." >&2
    exit 1
fi

# 7. Apply required security permissions
echo "[+] Setting secure permissions on Bitwarden vault..."
sudo chown root:root "$GPG_FILE"
sudo chmod 600 "$GPG_FILE"
sudo chown root:root "$BITWARDEN_DIR"
sudo chmod 755 "$BITWARDEN_DIR"

echo "[✓] Encryption completed and permissions secured!"

# 8. Deletion confirmation for plaintext file (No default)
while true; do
    read -rp "Delete the unencrypted info file '${INFO_FILE}'? (yes/y or no/n): " del_ans
    case "${del_ans,,}" in
        y|yes)
            if command -v shred >/dev/null 2>&1; then
                sudo shred -u -z -n 3 "$INFO_FILE" 2>/dev/null || sudo rm -f "$INFO_FILE"
            else
                sudo rm -f "$INFO_FILE"
            fi
            echo "[✓] Unencrypted info file deleted successfully."
            break
            ;;
        n|no)
            echo "[i] Keeping unencrypted info file at '${INFO_FILE}'."
            echo "[!] WARNING: Remember to delete it once you have confirmed your password!"
            break
            ;;
        *)
            echo "Please answer explicitly with 'yes'/'y' or 'no'/'n'."
            ;;
    esac
done
