[Unit]
Description=Rclone mount for FritzBox NAS Storage
AssertPathIsDirectory=%h/Fritzbox-Storage
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/bin/rclone mount fritzbox: %h/Fritzbox-Storage \
  --vfs-cache-mode full \
  --vfs-cache-max-age 24h \
  --vfs-read-ahead 128M \
  --dir-cache-time 1h \
  --log-level INFO
ExecStop=/bin/fusermount -u %h/Fritzbox-Storage
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
