#!/usr/bin/env bash
# Description: Shared execution dispatcher for Microsoft SQL Server container CLI tools (sqlcmd, sql-bcp)
# Note: Connects directly if only 1 version exists; presents a numbered selection menu if multiple.

set -euo pipefail

COMMAND_NAME="${1:-sqlcmd}"
shift || true

DISPLAY_TOOL="$COMMAND_NAME"
[[ "$COMMAND_NAME" == "bcp" ]] && DISPLAY_TOOL="sql-bcp"

SCRIPT_SOURCE="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"

# Source centralized framework colors
source "${SCRIPT_DIR}/../../../colors.sh"

SQLSERVER_DIR="${HOME}/.sqlserver"

if [[ ! -d "$SQLSERVER_DIR" ]]; then
    echo -e "${C_RED}[!] Error: No SQL Server instances directory found at ${SQLSERVER_DIR}.${C_RESET}" >&2
    echo "Run install.sqlserver.docker.sh to set up an instance." >&2
    exit 1
fi

# Find all version directories containing a docker-compose.yml
instances=()
while IFS= read -r dir; do
    if [[ -f "${dir}/docker-compose.yml" ]]; then
        instances+=("$dir")
    fi
done < <(find "$SQLSERVER_DIR" -mindepth 1 -maxdepth 1 -type d | sort -V)

if [[ ${#instances[@]} -eq 0 ]]; then
    echo -e "${C_RED}[!] Error: No configured SQL Server instances found in ${SQLSERVER_DIR}.${C_RESET}" >&2
    exit 1
fi

# Parse container info from docker-compose.yml
c_names=()
c_ports=()
c_passwords=()
c_versions=()

for inst_dir in "${instances[@]}"; do
    compose_file="${inst_dir}/docker-compose.yml"
    ver="$(basename "$inst_dir")"

    c_name=$(grep -E '^\s*container_name:' "$compose_file" | head -n 1 | awk '{print $2}' || true)
    [[ -z "$c_name" ]] && c_name="sqlserver-${ver}"

    c_port=$(grep -oE '[0-9]+:1433' "$compose_file" | head -n 1 | cut -d: -f1 || true)
    [[ -z "$c_port" ]] && c_port="1433"

    c_pass=$(grep -E 'MSSQL_SA_PASSWORD=' "$compose_file" | head -n 1 | cut -d= -f2- | tr -d ' "' || true)

    c_names+=("$c_name")
    c_ports+=("$c_port")
    c_passwords+=("$c_pass")
    c_versions+=("$ver")
done

TARGETED_PORT=""
TARGETED_INSTANCE=""
FORWARD_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --port)
            if [[ $# -gt 1 ]]; then
                TARGETED_PORT="$2"
                shift 2
            else
                shift
            fi
            ;;
        --port=*)
            TARGETED_PORT="${1#*=}"
            shift
            ;;
        --instance)
            if [[ $# -gt 1 ]]; then
                TARGETED_INSTANCE="$2"
                shift 2
            else
                shift
            fi
            ;;
        --instance=*)
            TARGETED_INSTANCE="${1#*=}"
            shift
            ;;
        -S|--server)
            if [[ $# -gt 1 ]]; then
                # Check if user specified port in -S host,port or -S port
                if [[ "$2" =~ ,([0-9]+)$ ]]; then
                    TARGETED_PORT="${BASH_REMATCH[1]}"
                elif [[ "$2" =~ ^[0-9]+$ ]]; then
                    TARGETED_PORT="$2"
                fi
                FORWARD_ARGS+=("$1" "$2")
                shift 2
            else
                FORWARD_ARGS+=("$1")
                shift
            fi
            ;;
        *)
            FORWARD_ARGS+=("$1")
            shift
            ;;
    esac
done

execute_in_container() {
    local idx="$1"
    shift
    local name="${c_names[$idx]}"
    local port="${c_ports[$idx]}"
    local ver="${c_versions[$idx]}"
    local pass="${c_passwords[$idx]}"

    # Locate binary inside the container (v18+ vs older path)
    local bin_path=""
    if docker exec "$name" test -x "/opt/mssql-tools18/bin/${COMMAND_NAME}" 2>/dev/null; then
        bin_path="/opt/mssql-tools18/bin/${COMMAND_NAME}"
    elif docker exec "$name" test -x "/opt/mssql-tools/bin/${COMMAND_NAME}" 2>/dev/null; then
        bin_path="/opt/mssql-tools/bin/${COMMAND_NAME}"
    else
        bin_path="${COMMAND_NAME}"
    fi

    local is_help=false
    local is_version=false

    for arg in "$@"; do
        if [[ "$arg" == "--help" || "$arg" == "-?" ]]; then
            is_help=true
            break
        elif [[ "$arg" == "--version" ]]; then
            is_version=true
            break
        fi
    done

    local docker_flags="-i"
    # Use interactive TTY only when both stdin/stdout are terminals and running interactive query
    if [[ -t 0 && -t 1 && "$COMMAND_NAME" == "sqlcmd" ]]; then
        docker_flags="-it"
    fi

    # Handle --version: print only the version header without help
    if [[ "$is_version" == "true" ]]; then
        echo -e "${C_GREEN}[+] Executing ${DISPLAY_TOOL} on container ${C_BOLD}${name}${C_RESET}${C_GREEN} (SQL Server ${ver}, port ${port})...${C_RESET}" >&2
        if [[ "$COMMAND_NAME" == "sqlcmd" ]]; then
            docker exec $docker_flags "$name" "$bin_path" "-?" 2>&1 | head -n 3
            exit 0
        else
            exec docker exec $docker_flags "$name" "$bin_path" "-v"
        fi
    fi

    # Handle --help: print full usage help
    if [[ "$is_help" == "true" ]]; then
        echo -e "${C_GREEN}[+] Executing ${DISPLAY_TOOL} on container ${C_BOLD}${name}${C_RESET}${C_GREEN} (SQL Server ${ver}, port ${port})...${C_RESET}" >&2
        exec docker exec $docker_flags "$name" "$bin_path" "-?"
    fi

    # Inspect user arguments to supply sensible defaults if omitted
    local has_server=false
    local has_user=false
    local has_pass=false
    local has_trust=false

    for arg in "$@"; do
        case "$arg" in
            -S|-S*) has_server=true ;;
            -U|-U*) has_user=true ;;
            -P|-P*) has_pass=true ;;
            -C|-N|-N*) has_trust=true ;;
        esac
    done

    local final_args=()

    if [[ "$has_server" == "false" ]]; then
        final_args+=("-S" "localhost")
    fi
    if [[ "$has_user" == "false" ]]; then
        final_args+=("-U" "sa")
    fi
    if [[ "$has_pass" == "false" && -n "$pass" ]]; then
        final_args+=("-P" "$pass")
    fi
    if [[ "$has_trust" == "false" && "$COMMAND_NAME" == "sqlcmd" ]]; then
        final_args+=("-C")
    fi

    final_args+=("$@")

    # Print connection notice to stderr so it does not corrupt stdout redirects
    echo -e "${C_GREEN}[+] Executing ${DISPLAY_TOOL} on container ${C_BOLD}${name}${C_RESET}${C_GREEN} (SQL Server ${ver}, port ${port})...${C_RESET}" >&2

    exec docker exec $docker_flags "$name" "$bin_path" "${final_args[@]}"
}

# Resolve targeted container if specified via port or instance name
MATCHED_IDX=""

if [[ -n "$TARGETED_PORT" ]]; then
    for i in "${!instances[@]}"; do
        if [[ "${c_ports[$i]}" == "$TARGETED_PORT" ]]; then
            MATCHED_IDX="$i"
            break
        fi
    done
    if [[ -z "$MATCHED_IDX" ]]; then
        echo -e "${C_RED}[!] Error: No SQL Server instance found listening on port ${TARGETED_PORT}.${C_RESET}" >&2
        exit 1
    fi
fi

if [[ -n "$TARGETED_INSTANCE" ]]; then
    for i in "${!instances[@]}"; do
        if [[ "${c_names[$i]}" == "$TARGETED_INSTANCE" || "${c_versions[$i]}" == "$TARGETED_INSTANCE" ]]; then
            MATCHED_IDX="$i"
            break
        fi
    done
    if [[ -z "$MATCHED_IDX" ]]; then
        echo -e "${C_RED}[!] Error: No SQL Server instance found matching '${TARGETED_INSTANCE}'.${C_RESET}" >&2
        exit 1
    fi
fi

# If target resolved directly via flag, execute without prompt
if [[ -n "$MATCHED_IDX" ]]; then
    execute_in_container "$MATCHED_IDX" "${FORWARD_ARGS[@]}"
fi

# If user requests global client help or version information, execute directly on the latest instance without prompt
for arg in "${FORWARD_ARGS[@]}"; do
    if [[ "$arg" == "--help" || "$arg" == "--version" || "$arg" == "-?" ]]; then
        latest_idx=$(( ${#instances[@]} - 1 ))
        if [[ ${#instances[@]} -gt 1 ]]; then
            other_instances=()
            for (( i=0; i<latest_idx; i++ )); do
                other_instances+=("${c_versions[$i]}")
            done
            other_list="$(printf ", %s" "${other_instances[@]}")"
            other_list="${other_list:2}"
            echo -e "${C_YELLOW}[i] Note: Showing ${DISPLAY_TOOL} from latest instance (${c_versions[$latest_idx]}). Other available instances: ${other_list} (use --port <port> or --instance <name> to query specific instance).${C_RESET}" >&2
        fi
        execute_in_container "$latest_idx" "${FORWARD_ARGS[@]}"
    fi
done

# Single instance: execute automatically without menu
if [[ ${#instances[@]} -eq 1 ]]; then
    execute_in_container 0 "${FORWARD_ARGS[@]}"
fi

# Multiple instances and no targeted flag provided: present interactive menu on stderr
echo "" >&2
echo -e "${C_BOLD}${C_CYAN}Available Microsoft SQL Server Instances for ${DISPLAY_TOOL}:${C_RESET}" >&2
echo "$DIV_SUB" >&2
printf "  ${C_BOLD}%-4s %-26s %-14s %-8s${C_RESET}\n" "#" "Container" "Version" "Port" >&2
echo "$DIV_SUB" >&2

for i in "${!instances[@]}"; do
    num=$((i + 1))
    printf "  [%s]  %-26s %-14s %-8s\n" \
        "$num" "${c_names[$i]}" "${c_versions[$i]}" "${c_ports[$i]}" >&2
done
echo "$DIV_SUB" >&2

while true; do
    echo -ne "${C_YELLOW}Select instance [1-${#instances[@]}] (or 'q' to quit): ${C_RESET}" >&2
    read -r choice || { echo "" >&2; exit 0; }

    if [[ "$choice" =~ ^[qQ]$ ]]; then
        echo "Cancelled." >&2
        exit 0
    fi

    if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#instances[@]} )); then
        selected_idx=$((choice - 1))
        execute_in_container "$selected_idx" "${FORWARD_ARGS[@]}"
    else
        echo -e "${C_RED}[!] Invalid selection. Please enter a number between 1 and ${#instances[@]}.${C_RESET}" >&2
    fi
done
