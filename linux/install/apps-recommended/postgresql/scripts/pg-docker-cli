#!/usr/bin/env bash
# Description: Shared execution dispatcher for PostgreSQL container CLI tools (psql, pg_dump, pg_restore)
# Note: Connects directly if only 1 version exists; presents a numbered selection menu if multiple.

set -euo pipefail

COMMAND_NAME="${1:-psql}"
shift || true

SCRIPT_SOURCE="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"

# Source centralized framework colors
source "${SCRIPT_DIR}/../../../colors.sh"

POSTGRES_DIR="${HOME}/.postgres"

if [[ ! -d "$POSTGRES_DIR" ]]; then
    echo -e "${C_RED}[!] Error: No PostgreSQL instances directory found at ${POSTGRES_DIR}.${C_RESET}" >&2
    echo "Run install.postgresql.docker.sh to set up an instance." >&2
    exit 1
fi

# Find all version directories containing a docker-compose.yml
instances=()
while IFS= read -r dir; do
    if [[ -f "${dir}/docker-compose.yml" ]]; then
        instances+=("$dir")
    fi
done < <(find "$POSTGRES_DIR" -mindepth 1 -maxdepth 1 -type d | sort -V)

if [[ ${#instances[@]} -eq 0 ]]; then
    echo -e "${C_RED}[!] Error: No configured PostgreSQL instances found in ${POSTGRES_DIR}.${C_RESET}" >&2
    exit 1
fi

# Parse container info from docker-compose.yml
c_names=()
c_ports=()
c_users=()
c_passwords=()
c_dbs=()
c_versions=()

for inst_dir in "${instances[@]}"; do
    compose_file="${inst_dir}/docker-compose.yml"
    ver="$(basename "$inst_dir")"

    c_name=$(grep -E '^\s*container_name:' "$compose_file" | head -n 1 | awk '{print $2}' || true)
    [[ -z "$c_name" ]] && c_name="postgres-${ver}"

    c_port=$(grep -oE '[0-9]+:5432' "$compose_file" | head -n 1 | cut -d: -f1 || true)
    [[ -z "$c_port" ]] && c_port="5432"

    c_user=$(grep -E 'POSTGRES_USER=' "$compose_file" | head -n 1 | cut -d= -f2- | tr -d ' "' || true)
    [[ -z "$c_user" ]] && c_user="postgres"

    c_pass=$(grep -E 'POSTGRES_PASSWORD=' "$compose_file" | head -n 1 | cut -d= -f2- | tr -d ' "' || true)
    [[ -z "$c_pass" ]] && c_pass="123"

    c_db=$(grep -E 'POSTGRES_DB=' "$compose_file" | head -n 1 | cut -d= -f2- | tr -d ' "' || true)
    [[ -z "$c_db" ]] && c_db="postgres"

    c_names+=("$c_name")
    c_ports+=("$c_port")
    c_users+=("$c_user")
    c_passwords+=("$c_pass")
    c_dbs+=("$c_db")
    c_versions+=("$ver")
done

TARGETED_PORT=""
TARGETED_INSTANCE=""
FORWARD_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -p|--port)
            if [[ $# -gt 1 ]]; then
                TARGETED_PORT="$2"
                shift 2
            else
                shift
            fi
            ;;
        -p=*|--port=*)
            TARGETED_PORT="${1#*=}"
            shift
            ;;
        --instance)
            if [[ $# -gt 1 ]]; then
                TARGETED_INSTANCE="$2"
                shift 2
            else
                shift
            fi
            ;;
        --instance=*)
            TARGETED_INSTANCE="${1#*=}"
            shift
            ;;
        *)
            FORWARD_ARGS+=("$1")
            shift
            ;;
    esac
done

execute_in_container() {
    local idx="$1"
    shift
    local name="${c_names[$idx]}"
    local port="${c_ports[$idx]}"
    local ver="${c_versions[$idx]}"

    local docker_flags="-i"
    # Use interactive TTY only when both stdin/stdout are terminals and not dumping/redirecting output
    if [[ -t 0 && -t 1 && ( "$COMMAND_NAME" == "psql" || "$COMMAND_NAME" == "pgbench" ) ]]; then
        docker_flags="-it"
    fi

    # Print connection notice to stderr so it does not corrupt stdout dumps (e.g. pg_dump > backup.sql)
    echo -e "${C_GREEN}[+] Executing ${COMMAND_NAME} on container ${C_BOLD}${name}${C_RESET}${C_GREEN} (PG ${ver}, port ${port})...${C_RESET}" >&2

    exec docker exec $docker_flags "$name" "$COMMAND_NAME" "$@"
}

# Resolve targeted container if specified via port or instance name
MATCHED_IDX=""

if [[ -n "$TARGETED_PORT" ]]; then
    for i in "${!instances[@]}"; do
        if [[ "${c_ports[$i]}" == "$TARGETED_PORT" ]]; then
            MATCHED_IDX="$i"
            break
        fi
    done
    if [[ -z "$MATCHED_IDX" ]]; then
        echo -e "${C_RED}[!] Error: No PostgreSQL instance found listening on port ${TARGETED_PORT}.${C_RESET}" >&2
        exit 1
    fi
fi

if [[ -n "$TARGETED_INSTANCE" ]]; then
    for i in "${!instances[@]}"; do
        if [[ "${c_names[$i]}" == "$TARGETED_INSTANCE" || "${c_versions[$i]}" == "$TARGETED_INSTANCE" ]]; then
            MATCHED_IDX="$i"
            break
        fi
    done
    if [[ -z "$MATCHED_IDX" ]]; then
        echo -e "${C_RED}[!] Error: No PostgreSQL instance found matching '${TARGETED_INSTANCE}'.${C_RESET}" >&2
        exit 1
    fi
fi

# If target resolved directly via flag, execute without prompt
if [[ -n "$MATCHED_IDX" ]]; then
    execute_in_container "$MATCHED_IDX" "${FORWARD_ARGS[@]}"
fi

# If user requests global client help or version information, execute directly on the latest instance without prompt
for arg in "${FORWARD_ARGS[@]}"; do
    if [[ "$arg" == "--help" || "$arg" == "-?" || "$arg" == "--version" || "$arg" == "-V" ]]; then
        latest_idx=$(( ${#instances[@]} - 1 ))
        if [[ ${#instances[@]} -gt 1 ]]; then
            other_instances=()
            for (( i=0; i<latest_idx; i++ )); do
                other_instances+=("${c_versions[$i]}")
            done
            other_list="$(printf ", %s" "${other_instances[@]}")"
            other_list="${other_list:2}"
            echo -e "${C_YELLOW}[i] Note: Showing ${COMMAND_NAME} from latest instance (${c_versions[$latest_idx]}). Other available instances: ${other_list} (use -p <port> or --instance <name> to query specific instance).${C_RESET}" >&2
        fi
        execute_in_container "$latest_idx" "${FORWARD_ARGS[@]}"
    fi
done

# Single instance: execute automatically
if [[ ${#instances[@]} -eq 1 ]]; then
    execute_in_container 0 "${FORWARD_ARGS[@]}"
fi

# Multiple instances and no targeted flag provided: present interactive menu on stderr
echo "" >&2
echo -e "${C_BOLD}${C_CYAN}Available PostgreSQL Instances for ${COMMAND_NAME}:${C_RESET}" >&2
echo "$DIV_SUB" >&2
printf "  ${C_BOLD}%-4s %-26s %-14s %-8s %-12s${C_RESET}\n" "#" "Container" "Version" "Port" "Database" >&2
echo "$DIV_SUB" >&2

for i in "${!instances[@]}"; do
    num=$((i + 1))
    printf "  [%s]  %-26s %-14s %-8s %-12s\n" \
        "$num" "${c_names[$i]}" "${c_versions[$i]}" "${c_ports[$i]}" "${c_dbs[$i]}" >&2
done
echo "$DIV_SUB" >&2

while true; do
    echo -ne "${C_YELLOW}Select instance [1-${#instances[@]}] (or 'q' to quit): ${C_RESET}" >&2
    read -r choice || { echo "" >&2; exit 0; }

    if [[ "$choice" =~ ^[qQ]$ ]]; then
        echo "Cancelled." >&2
        exit 0
    fi

    if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#instances[@]} )); then
        selected_idx=$((choice - 1))
        execute_in_container "$selected_idx" "${FORWARD_ARGS[@]}"
    else
        echo -e "${C_RED}[!] Invalid selection. Please enter a number between 1 and ${#instances[@]}.${C_RESET}" >&2
    fi
done
