#!/usr/bin/env bash
# Description: Interactive CLI connector for PostgreSQL multi-version Docker containers
# Note: Connects directly if only 1 version exists; presents a numbered selection list if multiple.

set -euo pipefail

# Resolve true directory of this script (supporting symlinks in ~/.local/bin)
TARGET_FILE="${BASH_SOURCE[0]}"
while [[ -L "$TARGET_FILE" ]]; do
    TARGET_DIR="$(cd -P "$(dirname "$TARGET_FILE")" && pwd)"
    TARGET_FILE="$(readlink "$TARGET_FILE")"
    [[ "$TARGET_FILE" != /* ]] && TARGET_FILE="${TARGET_DIR}/${TARGET_FILE}"
done
SCRIPT_DIR="$(cd -P "$(dirname "$TARGET_FILE")" && pwd)"

# Source centralized framework colors
source "${SCRIPT_DIR}/../../colors.sh"

POSTGRES_DIR="${HOME}/.postgres"

if [[ ! -d "$POSTGRES_DIR" ]]; then
    echo -e "${C_RED}[!] Error: No PostgreSQL instances directory found at ${POSTGRES_DIR}.${C_RESET}" >&2
    echo "Run install.postgresql.docker.sh to set up an instance." >&2
    exit 1
fi

# Find all version directories containing a docker-compose.yml
instances=()
while IFS= read -r dir; do
    if [[ -f "${dir}/docker-compose.yml" ]]; then
        instances+=("$dir")
    fi
done < <(find "$POSTGRES_DIR" -mindepth 1 -maxdepth 1 -type d | sort -V)

if [[ ${#instances[@]} -eq 0 ]]; then
    echo -e "${C_RED}[!] Error: No configured PostgreSQL instances found in ${POSTGRES_DIR}.${C_RESET}" >&2
    exit 1
fi

# Parse container info from docker-compose.yml
c_names=()
c_ports=()
c_users=()
c_passwords=()
c_dbs=()
c_versions=()

for inst_dir in "${instances[@]}"; do
    compose_file="${inst_dir}/docker-compose.yml"
    ver="$(basename "$inst_dir")"

    # Extract container name
    c_name=$(grep -E '^\s*container_name:' "$compose_file" | head -n 1 | awk '{print $2}' || true)
    [[ -z "$c_name" ]] && c_name="postgres-${ver}"

    # Extract host port
    c_port=$(grep -oE '[0-9]+:5432' "$compose_file" | head -n 1 | cut -d: -f1 || true)
    [[ -z "$c_port" ]] && c_port="5432"

    # Extract user, password, and db
    c_user=$(grep -E 'POSTGRES_USER=' "$compose_file" | head -n 1 | cut -d= -f2- | tr -d ' "' || true)
    [[ -z "$c_user" ]] && c_user="postgres"

    c_pass=$(grep -E 'POSTGRES_PASSWORD=' "$compose_file" | head -n 1 | cut -d= -f2- | tr -d ' "' || true)
    [[ -z "$c_pass" ]] && c_pass="123"

    c_db=$(grep -E 'POSTGRES_DB=' "$compose_file" | head -n 1 | cut -d= -f2- | tr -d ' "' || true)
    [[ -z "$c_db" ]] && c_db="postgres"

    c_names+=("$c_name")
    c_ports+=("$c_port")
    c_users+=("$c_user")
    c_passwords+=("$c_pass")
    c_dbs+=("$c_db")
    c_versions+=("$ver")
done

# Helper function to launch psql connection
connect_to() {
    local idx="$1"
    local name="${c_names[$idx]}"
    local port="${c_ports[$idx]}"
    local user="${c_users[$idx]}"
    local pass="${c_passwords[$idx]}"
    local db="${c_dbs[$idx]}"
    local ver="${c_versions[$idx]}"

    echo -e "${C_GREEN}[+] Connecting to ${C_BOLD}${name}${C_RESET}${C_GREEN} (PG ${ver}) on port ${C_BOLD}${port}${C_RESET}..."
    export PGPASSWORD="$pass"
    exec psql -h localhost -p "$port" -U "$user" -d "$db" "$@"
}

# Single instance: connect automatically
if [[ ${#instances[@]} -eq 1 ]]; then
    connect_to 0 "$@"
fi

# Multiple instances: present interactive menu
echo ""
echo -e "${C_BOLD}${C_CYAN}Available PostgreSQL Instances:${C_RESET}"
echo "$DIV_SUB"
printf "  ${C_BOLD}%-4s %-22s %-10s %-8s %-12s${C_RESET}\n" "#" "Container" "Version" "Port" "Database"
echo "$DIV_SUB"

for i in "${!instances[@]}"; do
    num=$((i + 1))
    printf "  [%s]  %-22s %-10s %-8s %-12s\n" \
        "$num" "${c_names[$i]}" "${c_versions[$i]}" "${c_ports[$i]}" "${c_dbs[$i]}"
done
echo "$DIV_SUB"

while true; do
    echo -ne "${C_YELLOW}Select instance [1-${#instances[@]}] (or 'q' to quit): ${C_RESET}"
    read -r choice || { echo ""; exit 0; }

    if [[ "$choice" =~ ^[qQ]$ ]]; then
        echo "Cancelled."
        exit 0
    fi

    if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#instances[@]} )); then
        selected_idx=$((choice - 1))
        connect_to "$selected_idx" "$@"
    else
        echo -e "${C_RED}[!] Invalid selection. Please enter a number between 1 and ${#instances[@]}.${C_RESET}"
    fi
done
