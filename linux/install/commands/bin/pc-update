#!/usr/bin/env bash

set -euo pipefail

sudo_keepalive_pid=""

cleanup() {
    if [[ -n "$sudo_keepalive_pid" ]]; then
        kill "$sudo_keepalive_pid" 2>/dev/null || true
    fi
}
trap cleanup EXIT INT TERM

echo "[+] Initializing sudo credentials..."
sudo -v

# Keep sudo timestamp updated in background every 60 seconds
while true; do
    sudo -n true
    sleep 60
    kill -0 "$$" 2>/dev/null || exit
done < /dev/null > /dev/null 2>&1 &
sudo_keepalive_pid=$!

echo "[+] Updating APT packages..."
sudo apt-get update
sudo apt-get upgrade -y
sudo apt-get autoremove -y

if command -v flatpak >/dev/null 2>&1; then
    echo "[+] Updating Flatpak applications..."
    sudo flatpak update -y
    sudo flatpak uninstall --unused -y
fi

if command -v snap >/dev/null 2>&1; then
    echo "[+] Refreshing Snap packages..."
    sudo snap refresh
fi

if command -v apache2 >/dev/null 2>&1; then
    echo "[+] Disabling apache2 service (prevents port conflict with nginx)..."
    sudo systemctl stop apache2.service
    sudo systemctl disable apache2.service
fi

echo "[+] Reloading systemd daemon..."
sudo systemctl daemon-reload

echo "[✓] System update completed successfully!"

########## Optional service overrides (uncomment if needed) ##########

# Disable systemd-resolved service only if you want to use another
# DNS resolver service such as dnsmasq (Not recommended).

#sudo systemctl stop systemd-resolved
#sudo systemctl disable systemd-resolved
